# Copie ce fichier en .env puis adapte les valeurs
POSTGRES_USER=pointage
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=pointage

DATABASE_URL=postgresql+psycopg://pointage:change-me-db@db:5432/pointage
REDIS_URL=redis://redis:6379/0

ENV=development
SECRET_KEY=change-me-long-random-string
CORS_ORIGINS=http://localhost:3000

# Clé qui chiffre les gabarits de visages (32 octets en base64).
# À générer UNE fois, à sauvegarder précieusement : sans elle, les visages enrôlés deviennent illisibles.
# Commande : docker run --rm python:3.11-slim python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FACE_ENCRYPTION_KEY=

# Empreinte digitale (WebAuthn / Windows Hello). Les valeurs par défaut conviennent au développement.
# Elles doivent correspondre EXACTEMENT à l'adresse du site dans le navigateur :
# en local http://localhost:3000 (et non 127.0.0.1) ; en production le vrai domaine en https.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGINS=http://localhost:3000
